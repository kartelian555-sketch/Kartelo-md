# ═══════════════════════════════════════════════
# KARTELO MD — Environment Variables Example
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════

# ── Owner Info ──
OWNER_NUMBER=254711939375
OWNER_NAME=KARTELO OFFICIAL
BOT_NAME=KARTELO MD

# ── Connection ──
USE_PAIRING_CODE=true
SESSION_ID=
PORT=3000

# ── Command Settings ──
PREFIX=.
MODE=public

# ── Panel ──
PANEL_PASSWORD=kartelo2024

# ── REST API ──
API_KEY=kartelo-secret-api-key-2024

# ── Bot Profile (auto-set on connect) ──
BOT_ABOUT=🤖 KARTELO MD — The Most Powerful WhatsApp Bot | Type .menu
BOT_DISPLAY_NAME=KARTELO MD

# ── Sticker Pack ──
PACKNAME=KARTELO MD
AUTHOR=By Kartelo

# ── External API Keys (optional — leave empty for free fallbacks) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WEATHER_API_KEY=

# ── Auto Behaviors ──
AUTO_TYPING=true
AUTO_READ=true
AUTO_STATUS_VIEW=true

# ── Auto Join ──
AUTO_JOIN_GROUP=
AUTO_JOIN_CHANNEL=
AUTO_JOIN_MESSAGE=👋 Welcome! Join our group and channel below:

# ── Links ──
CHANNEL_LINK=https://whatsapp.com/channel/0029VaZQBCKHk6Z5i3lQL83g
GITHUB_REPO=https://github.com/kartelian555-sketch/Kartelo-md

# ── Profile Picture ──
# Place a profile-pic.jpg in the root folder.
# The bot will auto-set it as the WhatsApp profile picture on connect.
# You can also use the .setpp command (reply to an image) to change it.
