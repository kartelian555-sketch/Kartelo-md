# ──────────────────────────────────────────────
# WhatsApp Bot — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Your WhatsApp number (country code + number, no + or spaces)
# Example: 2348012345678
OWNER_NUMBER=

# Authentication Mode
# true  = Use Pairing Code (enter phone number in terminal → get 8-digit code)
# false = Use QR Code (scan QR in terminal with WhatsApp)
USE_PAIRING_CODE=true

# Session ID (for cloud/server hosting)
# Generate by running: cat auth_info/creds.json | base64
# Paste the output here. The bot will restore the session automatically.
# Leave empty if using Pairing Code or QR Code locally.
SESSION_ID=

# Menu Banner Image
# Option 1: Place a file called menu.jpg in the artifacts/whatsapp-bot/ folder (recommended)
# Option 2: Set a direct image URL below
# If both are missing, the menu will send as text only.
MENU_IMAGE_URL=

# Admin Panel Password
PANEL_PASSWORD=kartelo2024

# ── Auto-Join Settings ──────────────────────────────
# When someone DMs the bot, it auto-sends group & channel invite links
# Also shown in the owner's connect message when bot logs in

# Group JID (e.g. 254711939375-1234567890@g.us)
# Get this by running .groupinfo in your group after adding the bot
# Leave empty to disable
AUTO_JOIN_GROUP=

# Channel JID (e.g. 12345678901234567890@newsletter)
# Get this from your channel settings
# Leave empty to disable
AUTO_JOIN_CHANNEL=

# Message sent with the invite links
AUTO_JOIN_MESSAGE=👋 Welcome! Join our group and channel below:
